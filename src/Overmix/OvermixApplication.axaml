<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Overmix.OvermixApplication"
             Name="Overmix"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Overmix/Styles/Theme.axaml" />
  </Application.Styles>
</Application>
