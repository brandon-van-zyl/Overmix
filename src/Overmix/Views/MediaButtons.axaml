<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Overmix.ViewModels"
             x:Class="Overmix.Views.MediaButtons"
             x:DataType="vm:OvermixViewModel">
  <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
    <Button Classes="icon" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous">
      <PathIcon Data="{StaticResource IconPrevious}" />
    </Button>
    <Button Classes="icon" Command="{Binding PlayPauseCommand}" ToolTip.Tip="Play or pause">
      <Panel>
        <PathIcon Data="{StaticResource IconPlay}" IsVisible="{Binding !IsPlaying}" />
        <PathIcon Data="{StaticResource IconPause}" IsVisible="{Binding IsPlaying}" />
      </Panel>
    </Button>
    <Button Classes="icon" Command="{Binding NextCommand}" ToolTip.Tip="Next">
      <PathIcon Data="{StaticResource IconNext}" />
    </Button>
  </StackPanel>
</UserControl>
