<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\overmix.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.1.0</Version>
    <!-- Overmix sits in the background while you play: skip the background GC thread and keep the heap small. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Precompiling Windows' API projections doubles their 25 MB for little gain; only Now Playing uses them. -->
  <ItemGroup>
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Overmix.Core\Overmix.Core.csproj" />
    <ProjectReference Include="..\Overmix.WindowsPlatform\Overmix.WindowsPlatform.csproj" />
  </ItemGroup>

  <!-- build\pack.ps1 bakes in the folder it packs releases into, so an installed Overmix updates itself from there. -->
  <ItemGroup Condition="'$(OvermixUpdateSource)' != ''">
    <AssemblyMetadata Include="OvermixUpdateSource" Value="$(OvermixUpdateSource)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Overmix.Tests" />
  </ItemGroup>

</Project>
