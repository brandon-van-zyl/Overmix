<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Overmix runs on Windows only, but code is also written and compile-checked on a Mac. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <WindowsTargetFramework>net10.0-windows10.0.19041.0</WindowsTargetFramework>
  </PropertyGroup>
</Project>
